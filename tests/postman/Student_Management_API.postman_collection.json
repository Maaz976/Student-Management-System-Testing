{
  "info": {
    "_postman_id": "a3d8f6b0-4b89-4c11-9e1e-2026sqe00001",
    "name": "Student Management System API Tests",
    "description": "Postman API test collection for SE3002 SQE Assignment 3 (Task 5). Covers GET, POST, PUT, DELETE, authentication, positive and negative cases, HTTP status assertions, and response field validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
