          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "4. Get All Students (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns non-empty students array', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.total).to.be.at.least(3);",
              "  pm.expect(json.data[0]).to.have.property('fullName');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "5. Create Student - Positive (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Created student matches payload', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.fullName).to.eql('Ayesha Khan');",
              "  pm.expect(json.data.class).to.eql('10');",
              "  pm.expect(json.data.rollNumber).to.eql('45');",
              "  pm.collectionVariables.set('createdStudentId', json.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ayesha Khan\",\n  \"class\": \"10\",\n  \"section\": \"A\",\n  \"rollNumber\": \"45\",\n  \"dob\": \"2008-05-14\",\n  \"email\": \"ayesha@example.com\",\n  \"phone\": \"03001234567\",\n  \"address\": \"Islamabad\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
