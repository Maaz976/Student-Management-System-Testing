      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Admin login succeeds and returns admin info', function () {",
              "  const json = pm.response.json();",
